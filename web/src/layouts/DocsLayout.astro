---
import BaseLayout from './BaseLayout.astro'
import { docsNav } from '../config/docsNav'

interface Props {
  title: string
  currentSlug: string
}

const { title, currentSlug } = Astro.props
---
<BaseLayout title={`${title} — PlopKit Docs`}>
  <div class="docs-layout">
    <aside class="docs-sidebar">
      {docsNav.map((group) => (
        <div class="nav-group">
          <h3 class="nav-group-title">{group.section}</h3>
          <ul>
            {group.pages.map((page) => {
              const href = page.slug ? `/docs/${page.slug}` : '/docs'
              const isActive = page.slug === currentSlug
              return (
                <li>
                  <a href={href} class={isActive ? 'active' : ''}>{page.title}</a>
                </li>
              )
            })}
          </ul>
        </div>
      ))}
    </aside>

    <main class="docs-content">
      <slot />
    </main>
  </div>
</BaseLayout>

<style>
  .docs-layout {
    display: flex;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 24px;
    gap: 48px;
  }

  .docs-sidebar {
    width: 220px;
    flex-shrink: 0;
  }

  .nav-group {
    margin-bottom: 28px;
  }

  .nav-group-title {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }

  .nav-group ul {
    list-style: none;
  }

  .nav-group li {
    margin-bottom: 6px;
  }

  .nav-group a {
    display: block;
    padding: 6px 10px;
    text-decoration: none;
    color: var(--pk-color-font);
    font-size: 0.9rem;
    font-weight: 500;
    border-left: 3px solid transparent;
  }

  .nav-group a:hover {
    background: #f5f5f5;
  }

  .nav-group a.active {
    border-left: 3px solid var(--red);
    font-weight: 700;
  }

  .docs-content {
    flex: 1;
    min-width: 0;
  }

  @media (max-width: 768px) {
    .docs-layout {
      flex-direction: column;
    }
    .docs-sidebar {
      width: 100%;
    }
  }
</style>