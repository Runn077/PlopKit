---
import BaseLayout from '../layouts/BaseLayout.astro'
import LandingNavbar from '../components/layout/LandingNavbar.astro'
import Footer from '../components/layout/Footer.astro'

const widgetUrl = `${import.meta.env.PUBLIC_APP_URL}/widget.js`
const widgetKey = import.meta.env.PUBLIC_DEMO_WIDGET_KEY
---
<BaseLayout title="Demo | PlopKit" description="Try a live PlopKit comment widget.">
  <div>
    <LandingNavbar />
    <div class="demo-container">
      <h1 class="demo-heading">Try it yourself</h1>
      <p class="demo-subheading">This is a live PlopKit comment widget.</p>
      <div id="widget-mount">
        <script src={widgetUrl} data-widget-key={widgetKey} data-widget="comments" is:inline></script>
      </div>
    </div>
    <Footer />
  </div>
</BaseLayout>

<script define:vars={{ widgetUrl, widgetKey }}>
  const container = document.getElementById('widget-mount')
  const script = document.createElement('script')
  script.src = widgetUrl
  script.setAttribute('data-widget-key', widgetKey)
  script.setAttribute('data-widget', 'comments')
  container?.appendChild(script)
</script>

<style>
  .demo-container {
    max-width: 720px;
    margin: 60px auto;
    padding: 0 24px;
  }

  .demo-heading {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .demo-subheading {
    font-size: 1rem;
    margin-bottom: 32px;
    opacity: 0.7;
  }
</style>