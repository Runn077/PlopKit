---
<nav class="navbar-landing">
  <a class="logo" href="/">PlopKit</a>

  <div class="nav-links">
    <a href="/demo"><button>Demo</button></a>
    <a href="/#pricing-section"><button>Pricing</button></a>
    <a href="/setup"><button>Setup</button></a>
    <a href="/login"><button>Login</button></a>
  </div>
</nav>

<style>
  .navbar-landing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 96px;
    padding: 0 32px;
    background: var(--red);
    border-bottom: 4px solid black;
    box-shadow: 0 6px 0 black;
    font-family: var(--pk-heading-font);
  }

  .logo {
    font-size: 3rem;
    font-weight: 900;
    color: white;
    -webkit-text-stroke: 0.5px black;
    text-shadow: 4px 4px 0 black;
    font-family: var(--pk-brand-font);
    cursor: pointer;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 20px;
  }

  .nav-links a {
    text-decoration: none;
  }

  .nav-links button {
    padding: 12px 20px;
    border: 3px solid black;
    background: white;
    font-size: 1rem;
    font-weight: 800;
    font-family: var(--pk-heading-font);
    cursor: pointer;
    box-shadow: 4px 4px 0 black;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .nav-links button:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 black;
  }

  @media (max-width: 768px) {
    .navbar-landing {
      height: auto;
      padding: 12px 16px;
      flex-wrap: wrap;
      row-gap: 10px;
    }
    .logo {
      font-size: 1.8rem;
      text-shadow: 2px 2px 0 black;
    }
    .nav-links {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
    }
    .nav-links button {
      padding: 8px 12px;
      font-size: 0.85rem;
    }
  }
</style>